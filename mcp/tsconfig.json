{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": [
      "node",
      "@angular/localize"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "../src/**/*.d.ts",
    "test/**/*.mts"
  ]
}
